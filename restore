#!/bin/bash
set -euo pipefail

BACKUP_FILE=${BACKUP_FILE:-"/backup/ckan-backup.tar"}
CKAN_STORAGE_PATH=${CKAN_STORAGE_PATH:-"/var/lib/ckan"}
POSTGRES_PORT=${POSTGRES_PORT:-5432}

if [[ ! -f "$BACKUP_FILE" ]]; then
    echo "Error: Backup file '$BACKUP_FILE' not found."
    exit 1
fi

# Validate the archive before touching the databases or the storage directory,
# so a bad archive can never leave a half-restored state. A single listing pass
# is reduced to the set of top-level entries and reused below. Nothing is
# extracted to the container filesystem: dumps are streamed, files are
# extracted straight into $CKAN_STORAGE_PATH.
echo "Validating backup archive..."
if ! ARCHIVE_ENTRIES=$(tar -tf "$BACKUP_FILE" | awk -F/ '!seen[$1]++ { print $1 }'); then
    echo "Error: could not read backup archive '$BACKUP_FILE' (truncated or damaged?)." >&2
    exit 1
fi

has_entry() {
    grep -qxF -- "$1" <<< "$ARCHIVE_ENTRIES"
}

if ! has_entry ckan-db.dump; then
    echo "Error: CKAN database dump file not found in backup." >&2
    exit 1
fi

if ! has_entry datastore-db.dump; then
    echo "Error: Datastore database dump file not found in backup." >&2
    exit 1
fi

# Determine which file directories are actually present in the archive, so a
# database-only or damaged archive can never wipe out the current files.
PRESENT_DIRS=()
for dir in resources storage webassets; do
    if has_entry "$dir"; then
        PRESENT_DIRS+=("$dir")
    else
        echo "Warning: '$dir' not found in archive, will be skipped."
    fi
done

if [[ ${#PRESENT_DIRS[@]} -eq 0 ]]; then
    echo "Error: none of 'resources', 'storage', 'webassets' found in backup archive." >&2
    echo "Refusing to wipe $CKAN_STORAGE_PATH for a database-only or damaged archive." >&2
    exit 1
fi

# Ensure the pg_restore client is not older than the server (older clients can
# fail or misbehave restoring a dump taken from a newer Postgres major version)
CLIENT_PG_VERSION=$(pg_restore --version | sed -E 's/[^0-9]*([0-9]+).*/\1/')
SERVER_PG_VERSION=$(PGPASSWORD="$CKAN_DB_PASSWORD" psql -h "$POSTGRES_HOST" -p "$POSTGRES_PORT" \
    -U "$CKAN_DB_USER" -d "$CKAN_DB" -tAc 'SHOW server_version_num' | cut -c1-2)
if [[ "$CLIENT_PG_VERSION" -lt "$SERVER_PG_VERSION" ]]; then
    echo "Error: pg_restore client (major version $CLIENT_PG_VERSION) is older than the database server (major version $SERVER_PG_VERSION)." >&2
    echo "Use a docker-ckan-backup image built on a Postgres client version >= the server." >&2
    exit 1
fi

# Restore the databases, streaming each dump from the archive to pg_restore
# (no -j: parallel restore needs a seekable file).
# The public schema is reset first: --clean only drops objects listed in the
# dump, so objects created by the target installation (e.g. foreign keys
# missing from an older dump) would block dropping tables/constraints.
# --no-owner/--no-privileges: the dump may come from an installation with
# different database roles; everything is owned by the connecting user.
reset_schema() {
    PGPASSWORD="$CKAN_DB_PASSWORD" psql -v ON_ERROR_STOP=1 \
        -h "$POSTGRES_HOST" -p "$POSTGRES_PORT" -U "$CKAN_DB_USER" -d "$1" \
        -c 'DROP SCHEMA IF EXISTS public CASCADE; CREATE SCHEMA public;'
}

echo "Restoring CKAN database..."
reset_schema "$CKAN_DB"
tar -xOf "$BACKUP_FILE" --occurrence=1 ckan-db.dump \
    | PGPASSWORD="$CKAN_DB_PASSWORD" pg_restore --verbose --clean --if-exists \
        --no-owner --no-privileges --format=custom \
        -h "$POSTGRES_HOST" -p "$POSTGRES_PORT" \
        -U "$CKAN_DB_USER" -d "$CKAN_DB"

echo "Restoring Datastore database..."
reset_schema "$DATASTORE_DB"
tar -xOf "$BACKUP_FILE" --occurrence=1 datastore-db.dump \
    | PGPASSWORD="$CKAN_DB_PASSWORD" pg_restore --verbose --clean --if-exists \
        --no-owner --no-privileges --format=custom \
        -h "$POSTGRES_HOST" -p "$POSTGRES_PORT" \
        -U "$CKAN_DB_USER" -d "$DATASTORE_DB"

# --no-privileges dropped all grants, including those of the DataStore
# read-only role; re-apply what `ckan datastore set-permissions` would set.
if [[ -n "${DATASTORE_READONLY_USER:-}" ]]; then
    echo "Restoring DataStore read-only permissions for '$DATASTORE_READONLY_USER'..."
    PGPASSWORD="$CKAN_DB_PASSWORD" psql -v ON_ERROR_STOP=1 -q \
        -h "$POSTGRES_HOST" -p "$POSTGRES_PORT" -U "$CKAN_DB_USER" -d "$DATASTORE_DB" \
        -v ro="$DATASTORE_READONLY_USER" -v db="$DATASTORE_DB" -v rw="$CKAN_DB_USER" <<'EOSQL'
GRANT CONNECT ON DATABASE :"db" TO :"ro";
GRANT USAGE ON SCHEMA public TO :"ro";
GRANT SELECT ON ALL TABLES IN SCHEMA public TO :"ro";
ALTER DEFAULT PRIVILEGES FOR ROLE :"rw" IN SCHEMA public GRANT SELECT ON TABLES TO :"ro";
EOSQL
fi

# Restore CKAN files (storage directory)
echo "Restoring CKAN storage files..."
rm -rf "$CKAN_STORAGE_PATH"/* "$CKAN_STORAGE_PATH"/.??*
tar -C "$CKAN_STORAGE_PATH" -xf "$BACKUP_FILE" "${PRESENT_DIRS[@]}"

# Ensure correct ownership
echo "Setting correct ownership for CKAN storage files..."
test "${RESTORE_OWNER:-}" != "" && { echo set owner="$RESTORE_OWNER"; chown -R $RESTORE_OWNER "$CKAN_STORAGE_PATH"; }

echo "Restore completed successfully!"
